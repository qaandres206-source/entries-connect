@page "/"
@rendermode InteractiveServer
@using cwApp.Models
@using cwApp.Services
@inject ConnectWiseService CwService
@inject ConfigStorageService ConfigStorage
@inject TicketContextService Bridge
@inject ReportService Reports
@inject IJSRuntime JS

<PageTitle>ControlPanelPSA</PageTitle>

<div class="cw-app @(isDark ? "dark" : "light")">

    <!-- HEADER / APP BAR -->
    <header class="appbar">
        <div class="appbar-left">
            <span class="appbar-icon">⏱</span>
            <span class="appbar-title">ControlPanelPSA</span>
        </div>
        <div class="appbar-actions">
            <button class="icon-btn" @onclick="OpenSettings" title="Configuración">⚙️</button>
            <button class="icon-btn" @onclick="ToggleTheme" title="Cambiar tema">
                @(isDark ? "☀️" : "🌙")
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="cw-main dashboard">

      <!-- COLUMNA IZQUIERDA: BOARD -->
      <div class="col col-left">
        <div class="card tickets-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <h2 class="section-title" style="margin:0; padding:0; border:none;">🗂 Board</h2>
                @if (config.IsComplete() && ticketsLoaded && ticketsError is null)
                {
                    <span class="board-count">@FilteredTickets.Count() / @myTickets.Count</span>
                }
            </div>

            @if (config.IsComplete())
            {
                <div class="filter-bar">
                    <div class="field-group" style="flex:1; min-width:160px;">
                        <label class="field-label">🔎 Company</label>
                        <input class="cw-input" list="companies-list" placeholder="Todas — escribe para filtrar"
                               @bind="companyQuery" @bind:event="oninput" />
                        <datalist id="companies-list">
                            @foreach (var c in companies)
                            {
                                <option value="@c.Name"></option>
                            }
                        </datalist>
                    </div>
                    <div class="field-group" style="flex:1; min-width:130px;">
                        <label class="field-label">Palabra clave</label>
                        <input class="cw-input" type="search" placeholder="acota la lista..."
                               @bind="keyword" @bind:event="oninput" />
                    </div>
                    <label class="cw-check" style="margin-bottom:8px;" title="Ver todos los tickets (no solo los tuyos)">
                        <input type="checkbox" @bind="includeUnassigned" />
                        <span class="check-mark"></span>
                        No asignados
                    </label>
                    <button class="icon-btn" style="background:var(--primary); width:auto; padding:8px 14px; font-size:0.82rem; gap:6px; white-space:nowrap; margin-bottom:8px;"
                            @onclick="LoadMyTickets" disabled="@isLoadingTickets" title="Aplicar filtro y cargar">
                        @if (isLoadingTickets) { <span class="spinner"></span> } else { <span>🔎 Filtrar</span> }
                    </button>
                </div>
                @if (includeUnassigned && string.IsNullOrWhiteSpace(companyQuery))
                {
                    <div class="report-hint" style="margin-bottom:8px;">Con "no asignados" conviene elegir una company; si no, se listan todos los abiertos (hasta 100). Usa la palabra clave para acotar.</div>
                }
            }

            @if (!config.IsComplete())
            {
                <div class="tickets-empty">⚙️ Ingresa tu Member ID y llaves en Configuración para ver tus tickets asignados.</div>
            }
            else if (ticketsError is not null)
            {
                <div class="tickets-error">@ticketsError</div>
                <button class="add-date-btn" style="margin-top:10px;" @onclick="LoadMyTickets" disabled="@isLoadingTickets">🔄 Reintentar</button>
            }
            else if (!ticketsLoaded)
            {
                <button class="add-date-btn" @onclick="LoadMyTickets" disabled="@isLoadingTickets">
                    @if (isLoadingTickets)
                    {
                        <span class="spinner" style="border-color:rgba(99,102,241,0.35); border-top-color:var(--primary);"></span>
                        <span>Cargando...</span>
                    }
                    else
                    {
                        <span>📥 Cargar mis tickets</span>
                    }
                </button>
            }
            else if (!myTickets.Any())
            {
                <div class="tickets-empty">No hay tickets abiertos con este filtro.</div>
            }
            else
            {
                <div class="tickets-list">
                    @foreach (var t in FilteredTickets)
                    {
                        <div class="ticket-item @(selectedTicketId == t.Id ? "selected" : "")" @key="t.Id" @onclick="() => SelectTicket(t)">
                            <div class="ticket-item-head">
                                <span style="display:flex; align-items:center; gap:8px;">
                                    <input type="checkbox" title="Incluir en el reporte"
                                           checked="@selectedForReport.Contains(t.Id)"
                                           @onclick:stopPropagation="true"
                                           @onchange="@(e => ToggleReportSelection(t.Id, e))" />
                                    <span class="ticket-id">#@t.Id</span>
                                </span>
                                <span class="ticket-status">@(t.Status?.Name ?? "—")</span>
                            </div>
                            <div class="ticket-summary">@t.Summary</div>
                            <div class="ticket-meta">@(t.Company?.Name ?? t.Company?.Identifier)</div>
                        </div>
                    }
                </div>

                <div class="report-bar">
                    <button class="submit-btn" style="padding:10px 20px; font-size:0.9rem;"
                            @onclick="DownloadTicketsReport" disabled="@isBuildingReport">
                        @if (isBuildingReport)
                        {
                            <span class="spinner"></span>
                            <span>Generando...</span>
                        }
                        else
                        {
                            <span>📊 Descargar reporte (.xlsx)</span>
                        }
                    </button>
                    <span class="report-hint">
                        @(selectedForReport.Any()
                            ? $"{selectedForReport.Count} ticket(s) seleccionados."
                            : "Sin selección → se incluyen todos los tickets listados.")
                    </span>
                </div>
            }
        </div><!-- /tickets-card -->
      </div><!-- /col-left -->

      <!-- COLUMNA DERECHA: detalle + entrada + log -->
      <div class="col col-right">

            @if (selectedTicketId is not null)
            {
                <div class="card detail-card">
                    <div class="dates-header" style="margin-bottom:10px;">
                        <span class="dates-icon">💬</span>
                        <span class="dates-title">Hilo del ticket #@selectedTicketId</span>
                        @if (selectedNotes.Any())
                        {
                            <button class="add-date-btn" style="margin-left:auto; padding:4px 12px; font-size:0.75rem;"
                                    @onclick="DownloadTicketDetailReport" disabled="@isBuildingReport">
                                📊 Exportar hilo
                            </button>
                        }
                    </div>
                    @if (isLoadingNotes)
                    {
                        <div class="tickets-empty">
                            <span class="spinner" style="border-color:rgba(99,102,241,0.35); border-top-color:var(--primary);"></span>
                            Cargando hilo...
                        </div>
                    }
                    else if (notesError is not null)
                    {
                        <div class="tickets-error">@notesError</div>
                    }
                    else if (!selectedNotes.Any())
                    {
                        <div class="tickets-empty">Este ticket no tiene notas.</div>
                    }
                    else
                    {
                        <div class="notes-thread">
                            @foreach (var n in selectedNotes)
                            {
                                <div class="note-item" @key="n.Id">
                                    <div class="note-head">
                                        <span class="note-badge note-@NoteTypeClass(n)">@NoteTypeLabel(n)</span>
                                        <span class="note-author">@(n.Member?.Name ?? n.CreatedBy ?? "—")</span>
                                        <span class="note-date">@(n.DateCreated?.ToString("yyyy-MM-dd HH:mm"))</span>
                                    </div>
                                    <div class="note-text">@n.Text</div>
                                </div>
                            }
                        </div>
                    }

                    @if (Bridge.IsEnabled)
                    {
                        <div class="dates-header" style="margin:18px 0 10px;">
                            <span class="dates-icon">🔗</span>
                            <span class="dates-title">Relacionado en ITGlue</span>
                        </div>
                        @if (isLoadingContext)
                        {
                            <div class="tickets-empty">
                                <span class="spinner" style="border-color:rgba(99,102,241,0.35); border-top-color:var(--primary);"></span>
                                Buscando en ITGlue...
                            </div>
                        }
                        else if (contextError is not null)
                        {
                            <div class="tickets-error">@contextError</div>
                        }
                        else if (ticketContext?.Organization is null)
                        {
                            <div class="tickets-empty">@(ticketContext?.Message ?? "Sin coincidencias en ITGlue.")</div>
                        }
                        else
                        {
                            <div class="ticket-meta" style="margin-bottom:8px;">
                                Organización: <strong>@ticketContext.Organization.Name</strong>
                            </div>
                            @if (!ticketContext.RelatedItems.Any())
                            {
                                <div class="tickets-empty">Sin configuraciones relacionadas para este ticket.</div>
                            }
                            else
                            {
                                <div class="notes-thread">
                                    @foreach (var it in ticketContext.RelatedItems)
                                    {
                                        <div class="itglue-item" @key="it.Id">
                                            <div class="itglue-head">
                                                <span class="note-badge note-default">@it.ResourceType</span>
                                                @if (it.WebLink is not null)
                                                {
                                                    <a class="itglue-link" href="@it.WebLink" target="_blank" rel="noopener">@it.Name</a>
                                                }
                                                else
                                                {
                                                    <span class="itglue-name">@it.Name</span>
                                                }
                                            </div>
                                            @if (it.Subtitle is not null)
                                            {
                                                <div class="ticket-meta">@it.Subtitle</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }

        <!-- FORM CARD -->
        <div class="card form-card">

            <!-- Title + Mode Toggle -->
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:4px;">
                <h2 class="section-title" style="margin:0;">Nueva Entrada</h2>
                <button class="icon-btn" style="padding:6px 14px; font-size:0.82rem; border-radius:8px; background:var(--accent); color:#fff; border:none; cursor:pointer; display:flex; align-items:center; gap:6px; white-space:nowrap;"
                        @onclick="ToggleMultiTicketMode" type="button" title="Cambiar modo de entrada">
                    @if (isMultiMode)
                    {
                        <span>📋 Entrada Múltiple</span>
                    }
                    else
                    {
                        <span>🎫 Entrada Sencilla</span>
                    }
                </button>
            </div>

            <!-- ===================== MODO SENCILLO (original) ===================== -->
            @if (!isMultiMode)
            {
                <!-- Ticket + Billable Row -->
                <div class="form-row wrap-row">
                    <div class="field-group">
                        <label class="field-label">Ticket ID</label>
                        <input class="cw-input" type="number" placeholder="Ej: 12345"
                               @bind="ticketId" @bind:event="oninput" autofocus />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Billable</label>
                        <select class="cw-select" @bind="billableOption">
                            <option value="Billable">Billable</option>
                            <option value="DoNotBill">Do Not Bill</option>
                            <option value="NoCharge">No Charge</option>
                        </select>
                    </div>
                </div>

                <!-- Description -->
                <div class="field-group full-width">
                    <label class="field-label">Descripción</label>
                    <textarea class="cw-textarea" rows="3" placeholder="Descripción de la actividad"
                              @bind="description" @bind:event="oninput"></textarea>
                </div>

                <!-- Checkboxes -->
                <div class="checkbox-row">
                    <label class="cw-check">
                        <input type="checkbox" @bind="addToDetail" />
                        <span class="check-mark"></span>
                        Discussion
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="addToInternal" />
                        <span class="check-mark"></span>
                        Internal
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="addToResolution" />
                        <span class="check-mark"></span>
                        Resolution
                    </label>
                    <div class="divider-v"></div>
                    <span class="notify-label">Notify:</span>
                    <label class="cw-check">
                        <input type="checkbox" @bind="emailResource" />
                        <span class="check-mark"></span>
                        Resource
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="emailContact" />
                        <span class="check-mark"></span>
                        Contact
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="emailCc" />
                        <span class="check-mark"></span>
                        CC
                    </label>
                </div>

                <!-- Dates Section -->
                <div class="dates-section">
                    <div class="dates-header">
                        <span class="dates-icon">📅</span>
                        <span class="dates-title">Fechas</span>
                        <span class="dates-range">Rango: @minDateStr a @maxDateStr</span>
                    </div>

                    @foreach (var entry in dateEntries)
                    {
                        <div class="date-row" @key="entry.Id">
                            <div class="field-group">
                                <label class="field-label">Fecha</label>
                                <input class="cw-input date-input" type="date"
                                       value="@entry.Date"
                                       min="@minDateStr"
                                       max="@maxDateStr"
                                       @onchange="@(e => entry.Date = e.Value?.ToString() ?? entry.Date)" />
                            </div>
                            <div class="field-group">
                                <label class="field-label">Hora Inicio</label>
                                <input class="cw-input time-input" type="time"
                                       value="@entry.StartTime"
                                       @onchange="@(e => entry.StartTime = e.Value?.ToString() ?? entry.StartTime)" />
                            </div>
                            <div class="field-group">
                                <label class="field-label">Horas</label>
                                <input class="cw-input hours-input" type="number"
                                       step="0.25" min="0.25" max="8"
                                       value="@entry.Hours"
                                       @onchange="@(e => { if(double.TryParse(e.Value?.ToString(), out var h)) entry.Hours = h; })" />
                            </div>
                            @if (dateEntries.Count > 1)
                            {
                                <button class="remove-btn" @onclick="() => RemoveDateEntry(entry)" title="Eliminar fecha">✖</button>
                            }
                        </div>
                    }

                    <button class="add-date-btn" @onclick="AddDateEntry">
                        <span>➕</span> Agregar fecha
                    </button>
                </div>

                <!-- Submit -->
                <div class="submit-row">
                    <button class="submit-btn @(isSubmitting ? "submitting" : "")"
                            @onclick="SubmitEntry"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <span>🚀 Registrar Entrada</span>
                        }
                    </button>
                </div>
            }

            <!-- ===================== MODO MÚLTIPLE ===================== -->
            @if (isMultiMode)
            {
                <!-- Shared Description -->
                <div class="field-group full-width" style="margin-top:8px;">
                    <label class="field-label">Descripción (compartida)</label>
                    <textarea class="cw-textarea" rows="2" placeholder="Descripción de la actividad (aplica a todos los tickets)"
                              @bind="description" @bind:event="oninput"></textarea>
                </div>

                <!-- Shared Checkboxes -->
                <div class="checkbox-row">
                    <label class="cw-check">
                        <input type="checkbox" @bind="addToDetail" />
                        <span class="check-mark"></span>
                        Discussion
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="addToInternal" />
                        <span class="check-mark"></span>
                        Internal
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="addToResolution" />
                        <span class="check-mark"></span>
                        Resolution
                    </label>
                    <div class="divider-v"></div>
                    <span class="notify-label">Notify:</span>
                    <label class="cw-check">
                        <input type="checkbox" @bind="emailResource" />
                        <span class="check-mark"></span>
                        Resource
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="emailContact" />
                        <span class="check-mark"></span>
                        Contact
                    </label>
                    <label class="cw-check">
                        <input type="checkbox" @bind="emailCc" />
                        <span class="check-mark"></span>
                        CC
                    </label>
                </div>

                <!-- Multi-ticket rows -->
                <div style="margin-top:12px; display:flex; flex-direction:column; gap:12px;">
                    @foreach (var mt in multiTickets)
                    {
                        <div class="dates-section" @key="mt.Id" style="border:1px solid var(--border); border-radius:10px; padding:12px;">

                            <!-- Ticket header row: ID + Billable + remove -->
                            <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; margin-bottom:8px;">
                                <div class="field-group" style="min-width:140px; flex:1;">
                                    <label class="field-label">Ticket ID</label>
                                    <input class="cw-input" type="number" placeholder="Ej: 12345"
                                           @bind="mt.TicketId" @bind:event="oninput" />
                                </div>
                                <div class="field-group" style="min-width:130px;">
                                    <label class="field-label">Billable</label>
                                    <select class="cw-select" @bind="mt.BillableOption">
                                        <option value="Billable">Billable</option>
                                        <option value="DoNotBill">Do Not Bill</option>
                                        <option value="NoCharge">No Charge</option>
                                    </select>
                                </div>
                                @if (multiTickets.Count > 1)
                                {
                                    <button class="remove-btn" style="margin-bottom:2px;"
                                            @onclick="() => RemoveMultiTicket(mt)" title="Eliminar ticket">✖</button>
                                }
                            </div>

                            <!-- Date entries for this ticket -->
                            <div class="dates-header" style="margin-bottom:6px;">
                                <span class="dates-icon">📅</span>
                                <span class="dates-title" style="font-size:0.82rem;">Fechas — Rango: @minDateStr a @maxDateStr</span>
                            </div>

                            @foreach (var de in mt.DateEntries)
                            {
                                <div class="date-row" @key="de.Id">
                                    <div class="field-group">
                                        <label class="field-label">Fecha</label>
                                        <input class="cw-input date-input" type="date"
                                               value="@de.Date"
                                               min="@minDateStr"
                                               max="@maxDateStr"
                                               @onchange="@(e => de.Date = e.Value?.ToString() ?? de.Date)" />
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label">Hora Inicio</label>
                                        <input class="cw-input time-input" type="time"
                                               value="@de.StartTime"
                                               @onchange="@(e => de.StartTime = e.Value?.ToString() ?? de.StartTime)" />
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label">Horas</label>
                                        <input class="cw-input hours-input" type="number"
                                               step="0.25" min="0.25" max="8"
                                               value="@de.Hours"
                                               @onchange="@(e => { if(double.TryParse(e.Value?.ToString(), out var h)) de.Hours = h; })" />
                                    </div>
                                    @if (mt.DateEntries.Count > 1)
                                    {
                                        <button class="remove-btn" @onclick="() => mt.DateEntries.Remove(de)" title="Eliminar fecha">✖</button>
                                    }
                                </div>
                            }

                            <button class="add-date-btn" @onclick="() => AddDateToMultiTicket(mt)">
                                <span>➕</span> Agregar fecha
                            </button>
                        </div>
                    }
                </div>

                <!-- Add ticket button -->
                <button class="add-date-btn" style="margin-top:12px;" @onclick="AddMultiTicket">
                    <span>➕</span> Agregar ticket
                </button>

                <!-- Submit -->
                <div class="submit-row" style="margin-top:14px;">
                    <button class="submit-btn @(isSubmitting ? "submitting" : "")"
                            @onclick="SubmitMultiEntry"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <span>🚀 Registrar Todos</span>
                        }
                    </button>
                </div>
            }

        </div>

        <!-- SESSION LOG -->
        <div class="card log-card">
            <h3 class="section-title">📋 Log de Sesión (Recientes)</h3>
            <div class="log-container">
                @if (!sessionLog.Any())
                {
                    <div class="log-empty">No hay entradas en este sesión</div>
                }
                @foreach (var log in sessionLog)
                {
                    <div class="log-entry @(log.IsError ? "log-error" : "log-success")">
                        <span class="log-icon">@(log.IsError ? "✗" : "✓")</span>
                        <span class="log-msg">@log.Message</span>
                    </div>
                }
            </div>
        </div>
      </div><!-- /col-right -->
    </main>
</div>

<!-- SNACKBAR -->
@if (snackbarVisible)
{
    <div class="snackbar @snackbarClass">
        @snackbarMessage
    </div>
}

<!-- SETTINGS MODAL -->
@if (settingsOpen)
{
    <div class="modal-overlay" @onclick="CloseSettings">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span>⚙️ Configuración</span>
                <button class="modal-close" @onclick="CloseSettings">✖</button>
            </div>
            <div class="modal-body">
                <h4 class="config-section-title">Credenciales de Usuario</h4>
                <div class="field-group">
                    <label class="field-label">Member ID</label>
                    <input class="cw-input" type="text" placeholder="Ej: username" @bind="editConfig.MemberId" />
                </div>
                <div class="field-group">
                    <label class="field-label">Public Key</label>
                    <input class="cw-input" type="@(showPublicKey ? "text" : "password")"
                           @bind="editConfig.PublicKey" />
                    <button class="reveal-btn" @onclick='() => showPublicKey = !showPublicKey'>
                        @(showPublicKey ? "🙈" : "👁")
                    </button>
                </div>
                <div class="field-group">
                    <label class="field-label">Private Key</label>
                    <input class="cw-input" type="@(showPrivateKey ? "text" : "password")"
                           @bind="editConfig.PrivateKey" />
                    <button class="reveal-btn" @onclick='() => showPrivateKey = !showPrivateKey'>
                        @(showPrivateKey ? "🙈" : "👁")
                    </button>
                </div>

                <details class="advanced-config">
                    <summary>⚙ Configuración Avanzada <small>Company ID, Site URL, Client ID</small></summary>
                    <div class="advanced-body">
                        <div class="field-group">
                            <label class="field-label">Company ID</label>
                            <input class="cw-input" type="@(showAdvanced ? "text" : "password")" @bind="editConfig.CompanyId" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Site URL</label>
                            <input class="cw-input" type="@(showAdvanced ? "text" : "password")" @bind="editConfig.SiteUrl" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Client ID</label>
                            <input class="cw-input" type="@(showAdvanced ? "text" : "password")" @bind="editConfig.ClientId" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Timezone Offset</label>
                            <input class="cw-input" type="@(showAdvanced ? "text" : "password")"
                                   placeholder="-4.0 para PR, -5.0 para COL"
                                   value="@editConfig.TimezoneOffset.ToString()"
                                   @onchange="@(e => { if(double.TryParse(e.Value?.ToString(), out var t)) editConfig.TimezoneOffset = t; })" />
                        </div>
                        <button class="reveal-adv-btn" @onclick='() => showAdvanced = !showAdvanced'>
                            @(showAdvanced ? "🙈 Ocultar" : "👁 Mostrar valores")
                        </button>
                    </div>
                </details>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseSettings">Cancelar</button>
                <button class="btn-save" @onclick="SaveSettings">💾 Guardar</button>
            </div>
        </div>
    </div>
}

@code {
    // ---- State (modo sencillo) ----
    private ConnectWiseConfig config = new();
    private ConnectWiseConfig editConfig = new();
    private List<DateEntry> dateEntries = new();
    private List<SessionLogEntry> sessionLog = new();

    private string ticketId = "";
    private string description = "";
    private string billableOption = "DoNotBill";
    private bool addToDetail = false;
    private bool addToInternal = true;
    private bool addToResolution = false;
    private bool emailResource = false;
    private bool emailContact = false;
    private bool emailCc = false;

    // ---- Estado modo múltiple ----
    private bool isMultiMode = false;

    /// <summary>
    /// Representa un ticket individual dentro del modo de entrada múltiple.
    /// Cada ticket tiene su propio Billable y lista de entradas de fecha/hora/horas.
    /// </summary>
    private class MultiTicketEntry
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string TicketId { get; set; } = "";
        public string BillableOption { get; set; } = "DoNotBill";
        public List<DateEntry> DateEntries { get; set; } = new();
    }

    private List<MultiTicketEntry> multiTickets = new();

    // ---- UI state ----
    private bool isSubmitting = false;
    private bool isDark = false;
    private bool settingsOpen = false;
    private bool showPublicKey = false;
    private bool showPrivateKey = false;
    private bool showAdvanced = false;

    // Snackbar
    private bool snackbarVisible = false;
    private string snackbarMessage = "";
    private string snackbarClass = "snackbar-success";
    private CancellationTokenSource? snackCts;

    // Date range
    private string minDateStr = "";
    private string maxDateStr = "";

    // ---- Estado: Mis Tickets (Fase 1 + 2) ----
    private List<TicketSummary> myTickets = new();
    private bool isLoadingTickets = false;
    private bool ticketsLoaded = false;
    private string? ticketsError = null;

    private int? selectedTicketId = null;
    private List<TicketNote> selectedNotes = new();
    private bool isLoadingNotes = false;
    private string? notesError = null;

    // ---- Estado: contexto ITGlue del ticket (Fase 3) ----
    private TicketContext? ticketContext = null;
    private bool isLoadingContext = false;
    private string? contextError = null;

    // ---- Estado: reportes .xlsx ----
    private HashSet<int> selectedForReport = new();
    private bool isBuildingReport = false;

    // ---- Estado: filtro (company / palabra clave / no asignados) ----
    private List<CompanyItem> companies = new();
    private bool companiesLoaded = false;
    private string companyQuery = "";
    private string keyword = "";
    private bool includeUnassigned = false;

    /// <summary>Lista mostrada: filtro por palabra clave (cliente) sobre los tickets cargados.</summary>
    private IEnumerable<TicketSummary> FilteredTickets =>
        string.IsNullOrWhiteSpace(keyword)
            ? myTickets
            : myTickets.Where(t =>
                (t.Summary?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.Company?.Name?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.Company?.Identifier?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.Status?.Name?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || t.Id.ToString().Contains(keyword));

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        maxDateStr = today.ToString("yyyy-MM-dd");
        var firstPrevMonth = today.Month == 1
            ? new DateTime(today.Year - 1, 12, 1)
            : new DateTime(today.Year, today.Month - 1, 1);
        minDateStr = firstPrevMonth.ToString("yyyy-MM-dd");

        AddDateEntry();

        config = await ConfigStorage.LoadAsync();
        if (!config.IsComplete())
            OpenSettings();
        else
            await LoadCompanies();
    }

    // ---- Mis Tickets (Fase 1 + 2) ----

    /// <summary>Carga los tickets abiertos del usuario actual. Solo corre con config completa.</summary>
    private async Task LoadMyTickets()
    {
        if (!config.IsComplete()) return;

        isLoadingTickets = true;
        ticketsError = null;
        try
        {
            if (!companiesLoaded) await LoadCompanies();

            int? companyId = null;
            if (!string.IsNullOrWhiteSpace(companyQuery))
            {
                var match = companies.FirstOrDefault(c =>
                    c.Name.Equals(companyQuery.Trim(), StringComparison.OrdinalIgnoreCase));
                companyId = match?.Id;
            }
            myTickets = await CwService.GetTicketsAsync(config, companyId, includeUnassigned);
            ticketsLoaded = true;
            // Si el ticket seleccionado ya no está en la lista, colapsa el detalle.
            if (selectedTicketId is not null && !myTickets.Any(t => t.Id == selectedTicketId))
                selectedTicketId = null;
        }
        catch (Exception ex)
        {
            ticketsError = $"No se pudieron cargar los tickets: {ex.Message}";
        }
        finally
        {
            isLoadingTickets = false;
        }
    }

    /// <summary>Carga la lista de companies para el desplegable de filtro (una sola vez).</summary>
    private async Task LoadCompanies()
    {
        try
        {
            companies = await CwService.GetCompaniesAsync(config);
            companiesLoaded = true;
        }
        catch
        {
            // Si falla, el filtro por company no estará disponible; los tickets se cargan igual.
            companiesLoaded = false;
        }
    }

    /// <summary>Selecciona/colapsa un ticket, precarga su id en el formulario y trae su hilo de notas.</summary>
    private async Task SelectTicket(TicketSummary t)
    {
        if (selectedTicketId == t.Id)
        {
            selectedTicketId = null;
            ticketContext = null;
            return;
        }

        selectedTicketId = t.Id;
        ticketId = t.Id.ToString();   // precarga el campo de modo sencillo
        selectedNotes = new();
        notesError = null;
        ticketContext = null;
        contextError = null;

        isLoadingNotes = true;
        try
        {
            selectedNotes = await CwService.GetTicketNotesAsync(config, t.Id.ToString());
        }
        catch (Exception ex)
        {
            notesError = $"No se pudieron cargar las notas: {ex.Message}";
        }
        finally
        {
            isLoadingNotes = false;
        }

        // Fase 3: contexto relacionado de ITGlue (solo si la key está configurada server-side).
        if (Bridge.IsEnabled)
        {
            isLoadingContext = true;
            try
            {
                ticketContext = await Bridge.GetContextAsync(t, selectedNotes);
            }
            catch (Exception ex)
            {
                contextError = $"ITGlue: {ex.Message}";
            }
            finally
            {
                isLoadingContext = false;
            }
        }
    }

    private static string NoteTypeLabel(TicketNote n) =>
        n.ResolutionFlag ? "Resolution" :
        n.InternalAnalysisFlag ? "Internal" :
        n.DetailDescriptionFlag ? "Discussion" : "Nota";

    private static string NoteTypeClass(TicketNote n) =>
        n.ResolutionFlag ? "resolution" :
        n.InternalAnalysisFlag ? "internal" :
        n.DetailDescriptionFlag ? "discussion" : "default";

    // ---- Reportes .xlsx (descarga local, sin email) ----

    private void ToggleReportSelection(int id, ChangeEventArgs e)
    {
        if (e.Value is true) selectedForReport.Add(id);
        else selectedForReport.Remove(id);
    }

    /// <summary>Genera y descarga el .xlsx con los tickets seleccionados (o todos si no hay selección).</summary>
    private async Task DownloadTicketsReport()
    {
        var chosen = selectedForReport.Any()
            ? myTickets.Where(t => selectedForReport.Contains(t.Id)).ToList()
            : myTickets;

        if (!chosen.Any())
        {
            await ShowSnackbar("⚠ No hay tickets para exportar", "error");
            return;
        }

        isBuildingReport = true;
        try
        {
            var bytes = Reports.BuildTicketsReport(chosen, config.MemberId);
            await SaveFile($"mis-tickets-{DateTime.Now:yyyyMMdd-HHmm}.xlsx", bytes);
            await ShowSnackbar($"✓ Reporte generado ({chosen.Count} tickets)", "success");
        }
        catch (Exception ex)
        {
            await ShowSnackbar($"✗ Error al generar el reporte: {ex.Message}", "error");
        }
        finally
        {
            isBuildingReport = false;
        }
    }

    /// <summary>Genera y descarga el .xlsx con el detalle y hilo de notas del ticket abierto.</summary>
    private async Task DownloadTicketDetailReport()
    {
        var ticket = myTickets.FirstOrDefault(t => t.Id == selectedTicketId);
        if (ticket is null) return;

        isBuildingReport = true;
        try
        {
            var bytes = Reports.BuildTicketDetailReport(ticket, selectedNotes);
            await SaveFile($"ticket-{ticket.Id}-{DateTime.Now:yyyyMMdd-HHmm}.xlsx", bytes);
            await ShowSnackbar($"✓ Hilo del ticket #{ticket.Id} exportado", "success");
        }
        catch (Exception ex)
        {
            await ShowSnackbar($"✗ Error al exportar: {ex.Message}", "error");
        }
        finally
        {
            isBuildingReport = false;
        }
    }

    /// <summary>Entrega los bytes al navegador como descarga (JS interop).</summary>
    private async Task SaveFile(string fileName, byte[] bytes)
    {
        await JS.InvokeVoidAsync("downloadFileFromBase64",
            fileName,
            Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    // ---- Modo sencillo: fechas ----
    private void AddDateEntry()
    {
        dateEntries.Add(new DateEntry
        {
            Date = DateTime.Today.ToString("yyyy-MM-dd"),
            StartTime = "08:00",
            Hours = 1.0
        });
    }

    private void RemoveDateEntry(DateEntry entry) => dateEntries.Remove(entry);

    // ---- Modo múltiple: tickets y fechas ----
    /// <summary>Alterna entre modo sencillo y modo de entrada múltiple.</summary>
    private void ToggleMultiTicketMode()
    {
        isMultiMode = !isMultiMode;
        if (isMultiMode && multiTickets.Count == 0)
            AddMultiTicket();
    }

    private void AddMultiTicket()
    {
        var mt = new MultiTicketEntry();
        mt.DateEntries.Add(new DateEntry
        {
            Date = DateTime.Today.ToString("yyyy-MM-dd"),
            StartTime = "08:00",
            Hours = 1.0
        });
        multiTickets.Add(mt);
    }

    private void RemoveMultiTicket(MultiTicketEntry mt) => multiTickets.Remove(mt);

    private void AddDateToMultiTicket(MultiTicketEntry mt)
    {
        mt.DateEntries.Add(new DateEntry
        {
            Date = DateTime.Today.ToString("yyyy-MM-dd"),
            StartTime = "08:00",
            Hours = 1.0
        });
    }

    // ---- Modo sencillo: submit ----
    private async Task SubmitEntry()
    {
        if (string.IsNullOrWhiteSpace(ticketId))
        {
            await ShowSnackbar("⚠ Por favor ingresa un Ticket ID", "error");
            return;
        }
        if (!dateEntries.Any())
        {
            await ShowSnackbar("⚠ Debe haber al menos una fecha", "error");
            return;
        }
        if (string.IsNullOrWhiteSpace(description))
        {
            await ShowSnackbar("⚠ Por favor ingresa una descripción", "error");
            return;
        }

        isSubmitting = true;
        int successCount = 0, errorCount = 0;

        foreach (var dateEntry in dateEntries.ToList())
        {
            var (ok, startHour) = ParseDateEntry(dateEntry, out var selectedDate);
            if (!ok) { errorCount++; continue; }

            var result = await CwService.PostTimeEntryAsync(
                config, ticketId, dateEntry.Hours, description, selectedDate, startHour,
                billableOption, addToDetail, addToInternal, addToResolution,
                emailResource, emailContact, emailCc);

            if (result.Success)
            {
                successCount++;
                AddLog($"✓ {dateEntry.Date}: Ticket #{ticketId} ({dateEntry.Hours}h) - {result.Message}");
            }
            else
            {
                errorCount++;
                AddLog($"✗ {dateEntry.Date}: Ticket #{ticketId} - {result.Message}", isError: true);
            }
        }

        isSubmitting = false;
        await HandleSubmitResult(successCount, errorCount);

        if (successCount > 0 && errorCount == 0)
        {
            ticketId = "";
            description = "";
            dateEntries.Clear();
            AddDateEntry();
        }
    }

    // ---- Modo múltiple: submit ----
    private async Task SubmitMultiEntry()
    {
        if (!multiTickets.Any(mt => !string.IsNullOrWhiteSpace(mt.TicketId)))
        {
            await ShowSnackbar("⚠ Ingresa al menos un Ticket ID", "error");
            return;
        }
        if (string.IsNullOrWhiteSpace(description))
        {
            await ShowSnackbar("⚠ Por favor ingresa una descripción", "error");
            return;
        }

        isSubmitting = true;
        int successCount = 0, errorCount = 0;

        foreach (var mt in multiTickets.ToList())
        {
            if (string.IsNullOrWhiteSpace(mt.TicketId)) continue;

            foreach (var de in mt.DateEntries.ToList())
            {
                var (ok, startHour) = ParseDateEntry(de, out var selectedDate);
                if (!ok) { errorCount++; continue; }

                var result = await CwService.PostTimeEntryAsync(
                    config, mt.TicketId, de.Hours, description, selectedDate, startHour,
                    mt.BillableOption, addToDetail, addToInternal, addToResolution,
                    emailResource, emailContact, emailCc);

                if (result.Success)
                {
                    successCount++;
                    AddLog($"✓ {de.Date}: Ticket #{mt.TicketId} ({de.Hours}h) - {result.Message}");
                }
                else
                {
                    errorCount++;
                    AddLog($"✗ {de.Date}: Ticket #{mt.TicketId} - {result.Message}", isError: true);
                }
            }
        }

        isSubmitting = false;
        await HandleSubmitResult(successCount, errorCount);

        if (successCount > 0 && errorCount == 0)
        {
            description = "";
            multiTickets.Clear();
            AddMultiTicket();
        }
    }

    // ---- Helpers ----

    /// <summary>
    /// Valida y convierte una entrada de fecha/hora en valores usables para la API.
    /// Devuelve (válido, horaInicio). Registra en log si hay error.
    /// </summary>
    private (bool valid, double startHour) ParseDateEntry(DateEntry entry, out DateTime selectedDate)
    {
        selectedDate = default;
        if (!DateTime.TryParse(entry.Date, out selectedDate))
        {
            AddLog($"Fecha inválida: {entry.Date}", isError: true);
            return (false, 0);
        }
        if (entry.Hours <= 0 || entry.Hours > 8)
        {
            AddLog($"Horas inválidas para {entry.Date}: {entry.Hours}", isError: true);
            return (false, 0);
        }
        double startHour = 8.0;
        if (!string.IsNullOrWhiteSpace(entry.StartTime))
        {
            var parts = entry.StartTime.Split(':');
            if (parts.Length >= 2 && int.TryParse(parts[0], out var h) && int.TryParse(parts[1], out var m))
                startHour = h + (m / 60.0);
        }
        return (true, startHour);
    }

    private async Task HandleSubmitResult(int successCount, int errorCount)
    {
        if (successCount > 0 && errorCount == 0)
            await ShowSnackbar($"✓ {successCount} entrada(s) registrada(s) exitosamente", "success");
        else if (successCount > 0)
            await ShowSnackbar($"Parcial: {successCount} exitosas, {errorCount} errores", "warning");
        else
            await ShowSnackbar($"✗ Error: {errorCount} entrada(s) fallaron", "error");
    }

    private void AddLog(string message, bool isError = false)
    {
        sessionLog.Insert(0, new SessionLogEntry
        {
            Message = message,
            IsError = isError,
            Timestamp = DateTime.Now
        });
    }

    private void ToggleTheme() => isDark = !isDark;

    private void OpenSettings()
    {
        editConfig = new ConnectWiseConfig
        {
            CompanyId = config.CompanyId,
            PublicKey = config.PublicKey,
            PrivateKey = config.PrivateKey,
            SiteUrl = config.SiteUrl,
            MemberId = config.MemberId,
            WorkType = config.WorkType,
            BillableOption = config.BillableOption,
            ClientId = config.ClientId,
            TimezoneOffset = config.TimezoneOffset
        };
        showPublicKey = false;
        showPrivateKey = false;
        showAdvanced = false;
        settingsOpen = true;
    }

    private void CloseSettings() => settingsOpen = false;

    private async Task SaveSettings()
    {
        config = editConfig;
        await ConfigStorage.SaveAsync(config);
        settingsOpen = false;
        await ShowSnackbar("✓ Configuración guardada", "success");
    }

    private async Task ShowSnackbar(string message, string type = "success")
    {
        snackCts?.Cancel();
        snackCts = new CancellationTokenSource();

        snackbarMessage = message;
        snackbarClass = type switch
        {
            "error" => "snackbar-error",
            "warning" => "snackbar-warning",
            _ => "snackbar-success"
        };
        snackbarVisible = true;
        StateHasChanged();

        try
        {
            await Task.Delay(3500, snackCts.Token);
            snackbarVisible = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }
}
